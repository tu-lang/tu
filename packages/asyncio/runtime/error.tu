// Error code aliases for asyncio.runtime (segment 0x03_02_xxxx).

RT_CANCELLED<i32>           = 0x03020001
RT_CLOSED<i32>              = 0x03020002
RT_RUNTIME_SHUTDOWN<i32>    = 0x03020005
RT_NO_BUDGET<i32>           = 0x03020009
RT_SEND_FULL<i32>          = 0x0302000A
RT_SIGNAL_NOT_REGISTERED<i32> = 0x0302000F
